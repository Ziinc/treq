#!/sbin/openrc-run
# Periodic merge-queue processor (calls edge function via local gateway).

name="merge-queue-cron"
description="Merge queue cron"
command="/usr/local/bin/run-merge-queue-cron.sh"
pidfile="/run/${RC_SVCNAME}.pid"
supervisor=supervise-daemon
respawn_delay=5

depend() {
  after nginx-gateway
  use nginx-gateway
}
