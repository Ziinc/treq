############
# treq single-tenant extras
# Appended to .env by bootstrap. Edit after first install as needed.
############

# Hosted web UI origin (auth redirects, dashboard links).
SITE_URL=http://localhost:3001

# Comma-separated Auth redirect allow-list. Keep the desktop deep link.
ADDITIONAL_REDIRECT_URLS=http://localhost:3001,http://localhost:3001/auth/callback,treq://auth/callback

# Auth signup defaults for a private single-tenant install.
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true

# Optional GitHub OAuth (web sign-in). Requires a GitHub OAuth App.
GITHUB_OAUTH_ENABLED=false
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# GitHub App used by merge-queue / webhook edge functions.
# Create a GitHub App for this tenant and fill these in.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=

# Studio labels
STUDIO_DEFAULT_ORGANIZATION=treq
STUDIO_DEFAULT_PROJECT=single-tenant
