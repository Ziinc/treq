{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "treq",
  "version": "0.1.2",
  "identifier": "com.treq",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../src/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src ipc: http://ipc.localhost ipc://localhost http://127.0.0.1:54321 https://tbgwjxmfxyobchwmgovz.supabase.co; img-src 'self' asset: http://asset.localhost data: blob: https://lh3.googleusercontent.com https://avatars.githubusercontent.com; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "cli": {
      "description": "Treq - Coding Agent Manager",
      "subcommands": {
        "workspace": {
          "description": "Manage treq workspaces",
          "subcommands": {
            "add": {
              "description": "Create a new workspace",
              "args": [
                { "name": "branch_name", "index": 1, "required": true, "description": "Branch name for the workspace" },
                { "name": "intent", "short": "i", "takesValue": true, "description": "Intent/description" },
                { "name": "source-branch", "short": "s", "takesValue": true, "description": "Source branch to stack on" }
              ]
            },
            "set": {
              "description": "Update workspace settings",
              "args": [
                { "name": "workspace_name", "index": 1, "required": true, "description": "Workspace branch name" },
                { "name": "intent", "short": "i", "takesValue": true, "description": "Set intent" },
                { "name": "target-branch", "short": "t", "takesValue": true, "description": "Set target branch" }
              ]
            },
            "st": {
              "description": "Show workspace status",
              "args": [
                { "name": "workspace_name", "index": 1, "description": "Workspace name (omit for all)" }
              ]
            },
            "ls": {
              "description": "List all workspaces with status"
            }
          }
        }
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["treq"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
