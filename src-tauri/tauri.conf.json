{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "treq",
  "version": "0.1.3",
  "identifier": "com.treq",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../src/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src ipc: http://ipc.localhost ipc://localhost http://127.0.0.1:54321 https://tbgwjxmfxyobchwmgovz.supabase.co; img-src 'self' asset: http://asset.localhost data: blob: https://lh3.googleusercontent.com https://avatars.githubusercontent.com; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$HOME/**/*",
            "$HOME/**/.treq/**/*"
          ],
          "deny": [
            "$HOME/.ssh/**"
          ]
        }
      }
    }
  },
  "plugins": {
    "cli": {
      "description": "Treq - AI Workspace Manager",
      "subcommands": {
        "add": {
          "description": "Create a new workspace",
          "args": [
            {
              "name": "branch_name",
              "index": 1,
              "takesValue": true,
              "required": true,
              "description": "Branch name for the workspace"
            },
            {
              "name": "description",
              "short": "d",
              "takesValue": true,
              "description": "Workspace description"
            },
            {
              "name": "title",
              "short": "l",
              "takesValue": true,
              "description": "Workspace title"
            },
            {
              "name": "source-branch",
              "short": "s",
              "takesValue": true,
              "description": "Source branch to stack on"
            }
          ]
        },
        "set": {
          "description": "Update workspace settings",
          "args": [
            {
              "name": "workspace_name",
              "index": 1,
              "takesValue": true,
              "required": true,
              "description": "Workspace branch name"
            },
            {
              "name": "description",
              "short": "d",
              "takesValue": true,
              "description": "Set description"
            },
            {
              "name": "title",
              "short": "l",
              "takesValue": true,
              "description": "Set title"
            },
            {
              "name": "target-branch",
              "short": "t",
              "takesValue": true,
              "description": "Set target branch"
            }
          ]
        },
        "st": {
          "description": "Show workspace status",
          "args": [
            {
              "name": "workspace_name",
              "index": 1,
              "takesValue": true,
              "description": "Workspace name (omit for all)"
            }
          ]
        },
        "mv": {
          "description": "Move selected changes from source workspace to destination workspace",
          "args": [
            {
              "name": "source",
              "index": 1,
              "takesValue": true,
              "required": true,
              "description": "Source workspace branch name"
            },
            {
              "name": "destination",
              "index": 2,
              "takesValue": true,
              "required": true,
              "description": "Destination workspace branch name"
            },
            {
              "name": "files",
              "short": "f",
              "takesValue": true,
              "multiple": true,
              "description": "Files to move"
            },
            {
              "name": "ranges",
              "short": "r",
              "takesValue": true,
              "multiple": true,
              "description": "Hunk ranges in file:start-end format"
            },
            {
              "name": "commits",
              "short": "c",
              "takesValue": true,
              "multiple": true,
              "description": "Commit IDs to move"
            }
          ]
        },
        "agent": {
          "description": "Start an agent session in a workspace",
          "args": [
            {
              "name": "branch",
              "index": 1,
              "takesValue": true,
              "required": true,
              "description": "Workspace branch name"
            },
            {
              "name": "prompt",
              "index": 2,
              "takesValue": true,
              "required": true,
              "description": "Prompt to send to the agent"
            },
            {
              "name": "mode",
              "short": "m",
              "takesValue": true,
              "description": "Permission mode: edit or plan"
            }
          ]
        },
        "repo": {
          "description": "Repository inspection and status commands",
          "args": [
            {
              "name": "action",
              "index": 1,
              "takesValue": true,
              "required": true,
              "description": "Repository action, for example inspect"
            },
            {
              "name": "repo",
              "long": "repo",
              "takesValue": true,
              "required": true,
              "description": "Repository path"
            },
            {
              "name": "format",
              "long": "format",
              "takesValue": true,
              "description": "Output format: human or json"
            }
          ]
        },
        "workspace": {
          "description": "List and inspect workspaces",
          "args": [
            {
              "name": "action",
              "index": 1,
              "takesValue": true,
              "required": true,
              "description": "Command action"
            },
            {
              "name": "repo",
              "long": "repo",
              "takesValue": true,
              "required": true,
              "description": "Repository path"
            },
            {
              "name": "workspace",
              "long": "workspace",
              "takesValue": true,
              "description": "Workspace numeric ID"
            },
            {
              "name": "format",
              "long": "format",
              "takesValue": true,
              "description": "Output format: human or json"
            }
          ]
        },
        "changes": {
          "description": "List changed files and file diffs",
          "args": [
            {
              "name": "action",
              "index": 1,
              "takesValue": true,
              "required": true,
              "description": "Command action"
            },
            {
              "name": "repo",
              "long": "repo",
              "takesValue": true,
              "required": true,
              "description": "Repository path"
            },
            {
              "name": "workspace",
              "long": "workspace",
              "takesValue": true,
              "description": "Workspace numeric ID"
            },
            {
              "name": "path",
              "long": "path",
              "takesValue": true,
              "description": "Repository-relative file path"
            },
            {
              "name": "format",
              "long": "format",
              "takesValue": true,
              "description": "Output format: human or json"
            }
          ]
        },
        "file": {
          "description": "Read repository files",
          "args": [
            {
              "name": "action",
              "index": 1,
              "takesValue": true,
              "required": true,
              "description": "Command action"
            },
            {
              "name": "repo",
              "long": "repo",
              "takesValue": true,
              "required": true,
              "description": "Repository path"
            },
            {
              "name": "workspace",
              "long": "workspace",
              "takesValue": true,
              "description": "Workspace numeric ID"
            },
            {
              "name": "path",
              "long": "path",
              "takesValue": true,
              "required": true,
              "description": "Repository-relative file path"
            },
            {
              "name": "revision",
              "long": "revision",
              "takesValue": true,
              "description": "working-copy or parent"
            },
            {
              "name": "start-line",
              "long": "start-line",
              "takesValue": true
            },
            {
              "name": "end-line",
              "long": "end-line",
              "takesValue": true
            },
            {
              "name": "format",
              "long": "format",
              "takesValue": true,
              "description": "Output format: human or json"
            }
          ]
        },
        "commits": {
          "description": "List commits",
          "args": [
            {
              "name": "action",
              "index": 1,
              "takesValue": true,
              "required": true,
              "description": "Command action"
            },
            {
              "name": "repo",
              "long": "repo",
              "takesValue": true,
              "required": true,
              "description": "Repository path"
            },
            {
              "name": "workspace",
              "long": "workspace",
              "takesValue": true,
              "description": "Workspace numeric ID"
            },
            {
              "name": "format",
              "long": "format",
              "takesValue": true,
              "description": "Output format: human or json"
            }
          ]
        },
        "conflicts": {
          "description": "List conflicted files",
          "args": [
            {
              "name": "action",
              "index": 1,
              "takesValue": true,
              "required": true,
              "description": "Command action"
            },
            {
              "name": "repo",
              "long": "repo",
              "takesValue": true,
              "required": true,
              "description": "Repository path"
            },
            {
              "name": "workspace",
              "long": "workspace",
              "takesValue": true,
              "description": "Workspace numeric ID"
            },
            {
              "name": "format",
              "long": "format",
              "takesValue": true,
              "description": "Output format: human or json"
            }
          ]
        }
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "treq"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
